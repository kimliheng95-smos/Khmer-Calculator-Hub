# Khmer Calculator Hub — Apache settings

# Enable PHP if needed (some hosts)
# AddHandler application/x-httpd-php .php

# Protect sensitive files
<FilesMatch "\.(sql|md|json)$">
  Require all denied
</FilesMatch>

# Prevent directory listing
Options -Indexes

# UTF-8
AddDefaultCharset UTF-8

# Security headers (optional, safe)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# If site is in a subfolder and rewrite is needed, you usually don't need more.
# PHP sessions work with the cookie path="/" set in config.php.
